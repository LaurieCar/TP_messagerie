meta {
  name: connexions A
  type: http
  seq: 3
}

get {
  url: {{A}}/connexions
  body: none
  auth: none
}

docs {
  connexion activé retourne: 
  {
    "enCours": [],
    "actives": [
      "http://localhost:3001"
    ],
    "inactives": {}
  }
  
  lorsque le serveur ne répond plus, il  rentre dans la liste des inactifs: 
  {
    "enCours": [],
    "actives": [],
    "inactives": {
      "http://localhost:3001": "PERDU"
    }
  }
}
